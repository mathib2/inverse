ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
# ZETARIS_BASE_URL=http://localhost:3000     # the organizers' smoke_test.py reads this one
# Model provider: ollama (default: local models on this machine, no cloud) | nightshift (Meterless Nightshift, the sponsor path) | openai (any OpenAI-compatible server)
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_API_KEY=ollama                 # Ollama ignores the key; any value works
NEMOTRON_MODEL=nemotron-mini:latest  # the id Ollama lists (docs/agent/LOCAL_MODELS.md)
# MODEL_TIMEOUT=600                  # seconds per model call (default 600 for local providers, 180 for Nightshift)
# Sponsor path (Meterless Nightshift through the tunnel, docs/agent/NIGHTSHIFT_TUNNEL.md):
# MODEL_PROVIDER=nightshift
# MODEL_BASE_URL=http://127.0.0.1:8088/v1
# MODEL_API_KEY=your-nightshift-runtime-token
# NEMOTRON_MODEL=your-meterless-route-or-model-id
# Optional lanes. With Nightshift they default to Nemotron routes; with a local provider every lane defaults to NEMOTRON_MODEL.
# LANE_CRITIC=qwen2.5:3b-instruct   # local: a second model, so Vera reviews on a model different from the one that did the work
# LANE_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
# LANE_DEEP=nvidia/nemotron-3-ultra-550b-a55b
# LANE_CRITIC=nvidia/nemotron-3.5-super-vl-120b-a12b
# Services (defaults shown): MARKOVIAN_URL=http://127.0.0.1:8101  SIDECAR_PORT=8100  MARKOVIAN_PORT=8101
# Warden (scripts/watch.py): WATCH_INTERVAL=1800  WATCH_EQUIPMENT=P-104,T-200  WATCH_WEBHOOK=https://...
# UI: INVERSE_SHOW_SSH_TARGET=1 prints the reconnect address in the sidebar (off by default for shared screens)
# UI sign-in page (python scripts/set_password.py writes both; without UI_PASSWORD_HASH there is no sign-in page):
# UI_USER=root
# UI_PASSWORD_HASH=pbkdf2_sha256$200000$<salt>$<hash>
# Your phone, for free (docs/AUTONOMY_LOOP.md): any of these; none is required.
# NTFY_TOPIC=inverse-<a long random word>        (the ntfy app subscribes to it; an approval request rings like a call)
# TELEGRAM_BOT_TOKEN=   TELEGRAM_CHAT_ID=
# SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=  SMTP_PASS=   NOTIFY_SMS_TO=10digits@vtext.com   (a carrier's email-to-SMS gateway)
# Tinker, the improvement loop (runs from the sandbox clone): TINKER_INTERVAL=1800  TINKER_BRANCH=m4-sindyc  INVERSE_LIVE=~/inverse-live

