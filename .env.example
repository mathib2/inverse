ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
# Model provider: nightshift (Meterless Nightshift, the sponsor path) | ollama (a local server on this machine) | openai (any OpenAI-compatible server)
MODEL_PROVIDER=nightshift
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=your-nightshift-runtime-token
NEMOTRON_MODEL=your-meterless-route-or-model-id
# Local lab example (free, no laptop, no credits; see docs/agent/LOCAL_MODELS.md):
# MODEL_PROVIDER=ollama
# MODEL_BASE_URL=http://127.0.0.1:11434/v1
# MODEL_API_KEY=ollama
# NEMOTRON_MODEL=nemotron-mini:latest
# Optional: team lanes. With Nightshift they default to Nemotron routes; with a local provider every lane defaults to NEMOTRON_MODEL.
# LANE_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
# LANE_DEEP=nvidia/nemotron-3-ultra-550b-a55b
# LANE_CRITIC=nvidia/nemotron-3.5-super-vl-120b-a12b
# LANE_CRITIC=qwen2.5:3b-instruct   # local lab: a second model, so the Critic stays independent of the work it reviews
