ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
# ZETARIS_BASE_URL=http://localhost:3000     # the organizers' smoke_test.py reads this one
# Model provider: nightshift (the default, also when unset) | ollama (local models on this machine, no laptop) | openai (any OpenAI-compatible server)
# Nightshift (the Meterless Nightshift Runtime) runs on a Windows laptop; an SSH reverse tunnel from the laptop ends on this
# machine's port 8088 (docs/operations/NIGHTSHIFT_TUNNEL.md).
MODEL_PROVIDER=nightshift
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=your-nightshift-runtime-key   # the Runtime key from Nightshift's Console
NEMOTRON_MODEL=local-runtime/nemotron-mini-4b-instruct-q4-k-m   # a route Nightshift lists; the sidebar checks for it
# The lanes. With nightshift a lane left unset asks for a large hosted Nemotron route (core/inverse_core/team/lanes.py) that the
# laptop does not serve, so all three name the laptop's lane: Nemotron-Mini-4B on its GPU.
LANE_FAST=local-runtime/nemotron-mini-4b-instruct-q4-k-m
LANE_DEEP=local-runtime/nemotron-mini-4b-instruct-q4-k-m
LANE_CRITIC=local-runtime/nemotron-mini-4b-instruct-q4-k-m
# MODEL_TIMEOUT=300                  # seconds per model call (default 300 with nightshift, 600 with any other provider)
# The fallback: a call Nightshift cannot answer goes to this server with this model, and Nightshift is tried first again two
# minutes later. The defaults are the workstation's Ollama and the same Nemotron model; MODEL_FALLBACK_URL=off turns it off.
# MODEL_FALLBACK_URL=http://127.0.0.1:11434/v1
# MODEL_FALLBACK_MODEL=nemotron-mini:latest
# MODEL_FALLBACK_TIMEOUT=600         # seconds per fallback call
# MODEL_FALLBACK_KEY=ollama  MODEL_FALLBACK_NAME=Ollama on the workstation   (the name the sidebar shows when the fallback answers)
# Local only, no laptop (Tinker's sandbox runs this way, docs/operations/LOCAL_MODELS.md): these lines replace the MODEL_ and LANE_ lines above.
# MODEL_PROVIDER=ollama
# MODEL_BASE_URL=http://127.0.0.1:11434/v1
# MODEL_API_KEY=ollama                 # Ollama ignores the key; any value works
# NEMOTRON_MODEL=nemotron-mini:latest  # the id Ollama lists; with a local provider every lane left unset uses it
# LANE_CRITIC=qwen2.5:3b-instruct      # optional: a second model, so Vera reviews on a model different from the one that did the work
# Warden (scripts/watch.py): WATCH_INTERVAL=1800  WATCH_EQUIPMENT=P-104,T-200  WATCH_WEBHOOK=https://...
# UI: INVERSE_SHOW_SSH_TARGET=1 prints the reconnect address in the sidebar (off by default for shared screens)
# UI sign-in page (python scripts/admin/set_password.py writes both; without UI_PASSWORD_HASH there is no sign-in page):
# UI_USER=root
# UI_PASSWORD_HASH=pbkdf2_sha256$200000$<salt>$<hash>
# Your phone, for free (docs/TINKER.md): any of these; none is required.
# NTFY_TOPIC=inverse-<a long random word>        (the ntfy app subscribes to it; an approval request rings like a call)
# TELEGRAM_BOT_TOKEN=   TELEGRAM_CHAT_ID=
# SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=  SMTP_PASS=   NOTIFY_SMS_TO=10digits@vtext.com   (a carrier's email-to-SMS gateway)
# TEXTBELT_TO=1555xxxxxxx   (one free text a day, no account; TEXTBELT_KEY for a paid key)
# Tinker, the improvement loop (runs from the sandbox clone): TINKER_INTERVAL=1800  TINKER_BRANCH=m4-sindyc  INVERSE_LIVE=~/inverse-live
#   TINKER_AUTOMERGE=council|human  TINKER_VETO_MINUTES=30  INVERSE_DEPLOY=~/.local/bin/deploy-live
#   TINKER_ENGINEER_MODEL=qwen2.5-coder:7b   # the model of Tinker's engineer step only (measured by scripts/measure/engineer_eval.py); unset = the deep lane

# This checkout's own Meterless sidecars: H-MEM and the World Model on SIDECAR_URL, Markovian on MARKOVIAN_URL. scripts/run_sidecars.sh
# starts them on these ports. Give each checkout on one machine its own pair, so their memories never mix. Defaults: 8100 and 8101.
SIDECAR_URL=http://127.0.0.1:8100
MARKOVIAN_URL=http://127.0.0.1:8101
