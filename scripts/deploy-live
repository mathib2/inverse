#!/usr/bin/env bash
# Update the live INVERSE UI (port 8501 on the workstation) to the latest m4-sindyc on GitHub.
# Install: cp scripts/deploy-live ~/.local/bin/ && chmod +x ~/.local/bin/deploy-live
# It runs from its own clean checkout (~/inverse-live), so work in ~/open-agent-hack never shows on the link.
set -euo pipefail
cd ~/inverse-live
# A deploy restarts the UI and Warden, which cuts a running mission short: wait for it (up to 20 min) unless --now is given.
if [ "${1:-}" != "--now" ]; then
  wait_s=$(( ${DEPLOY_WAIT_MIN:-20} * 60 )); waited=0
  while [ -f state/current.json ] || [ -f state/ui_mission.json ]; do
    [ "$waited" = 0 ] && echo "a mission is running; waiting up to $(( wait_s / 60 )) min for it to finish (deploy-live --now to skip)"
    if [ "$waited" -ge "$wait_s" ]; then echo "still running after $(( wait_s / 60 )) min: not deploying (deploy-live --now to force)" >&2; exit 3; fi
    sleep 10; waited=$(( waited + 10 ))
  done
fi
before=$(git rev-parse HEAD)
git pull --ff-only -q origin m4-sindyc
if ! git diff --quiet "$before" HEAD -- requirements.txt; then
  .venv/bin/python -m pip install -q --disable-pip-version-check -r requirements.txt
fi
tmux respawn-pane -k -t 3:1 "cd ~/inverse-live && PYTHONPATH=core .venv/bin/streamlit run ui/app.py --server.port 8501 --server.address 127.0.0.1 --server.headless true --client.showErrorDetails type > ~/streamlit.log 2>&1"
# This checkout's own sidecars (H-MEM/World Model and Markovian, on the ports SIDECAR_URL and MARKOVIAN_URL name in .env), restarted
# so they run the code just deployed. Only a process serving from this checkout's sidecar folder is stopped, never another folder's.
tmux kill-session -t inverse-markovian 2>/dev/null || true          # the old fixed-port (8101) Markovian session, retired
SIDE="$HOME/inverse-live/services/meterless-sidecar"
port_of() { echo "$1" | sed -n 's|.*:\([0-9][0-9]*\).*|\1|p'; }
for k in SIDECAR_URL MARKOVIAN_URL; do
  p=$(port_of "$(grep -m1 "^$k=" .env | cut -d= -f2- || true)"); [ -n "$p" ] || continue
  pid=$(ss -ltnp 2>/dev/null | grep ":$p " | grep -o "pid=[0-9]*" | head -1 | cut -d= -f2 || true)   # nothing listening is not an error
  if [ -n "$pid" ] && [ "$(readlink "/proc/$pid/cwd")" = "$SIDE" ]; then kill "$pid" 2>/dev/null || true; fi
done
sleep 1
bash scripts/run_sidecars.sh || true
~/.local/bin/inverse-watch restart || true          # the watcher runs the code it was deployed with
for _ in $(seq 1 30); do
  if curl -sf -m 2 http://127.0.0.1:8501/_stcore/health >/dev/null; then
    echo "live UI is up on $(git log -1 --format='%h %s')"; exit 0
  fi
  sleep 1
done
echo "UI did not come up; see ~/streamlit.log" >&2; exit 1
